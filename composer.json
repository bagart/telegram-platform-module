{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-module-engine",
    "description": "Module engine for the Telegram bot platform: declarative module registry, config policy, lifecycle and per-bot activation contracts",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "bot-platform",
        "module-engine",
        "modularity"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramModuleEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramModuleEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/pest"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../telegram-bot-lib"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
